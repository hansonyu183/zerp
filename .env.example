# 各环境必须替换为可访问的真实后端 API，末尾建议保留斜杠。
VITE_API_BASE_URL=https://api.example.com/

# 以下变量仅供 Playwright 本地/CI 进程读取，不会进入前端构建。
E2E_API_BASE_URL=https://api-test.example.com/
E2E_USERNAME=
E2E_PASSWORD=
E2E_REVIEWER_USERNAME=
E2E_REVIEWER_PASSWORD=

# VOU E2E 使用的有效 BOB 基础资料关键字（推荐填写唯一编码）。
# 客户必须配置结算方式；车辆必须属于这里指定的物流平台。
E2E_VOU_CUSTOMER_KEYWORD=
E2E_VOU_EMPLOYEE_KEYWORD=
E2E_VOU_WAREHOUSE_KEYWORD=
E2E_VOU_PRODUCT_KEYWORD=
E2E_VOU_PLATFORM_KEYWORD=
E2E_VOU_VEHICLE_KEYWORD=
E2E_VOU_FUND_ACCOUNT_KEYWORD=
E2E_VOU_CURRENCY=CNY
