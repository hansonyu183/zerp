POSTGRES_PORT=55432
POSTGRES_DB=zerp
POSTGRES_USER=zerp
POSTGRES_PASSWORD=replace-with-a-random-production-password
API_PORT=8080
WEB_PORT=8088
TARGET_API_BROWSER_URL=https://zerp-api.bytesucceed.com
CORS_ALLOWED_ORIGINS=https://zerp.bytesucceed.com
APP_SESSION_COOKIE_NAME=zerp_session
APP_SESSION_COOKIE_SECURE=true
APP_SESSION_COOKIE_SAME_SITE=lax
APP_TEST_ADMIN_PASSWORD_FILE=/absolute/path/to/zerp/test-admin-password
APP_TESTER_PASSWORD_FILE=/absolute/path/to/zerp/tester-password
ZERP_API_IMAGE=ghcr.io/hansonyu183/zerp-api:replace-with-release-sha
ZERP_WEB_IMAGE=ghcr.io/hansonyu183/zerp-web:replace-with-release-sha
ZERP_RELEASE_SHA=replace-with-40-character-lowercase-git-sha
