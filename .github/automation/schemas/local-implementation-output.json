{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "commitSha", "validation", "review"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "needs_input", "blocked"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "commitSha": {
      "type": "string"
    },
    "validation": {
      "type": "string",
      "enum": ["passed", "not_run"]
    },
    "review": {
      "type": "string",
      "enum": ["passed", "not_run"]
    }
  }
}
