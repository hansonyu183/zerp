{
  "name": "@zerp/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./client": "./src/app/contract.ts"
  },
  "scripts": {
    "dev": "node src/server.ts",
    "test": "pnpm test:unit && pnpm test:artifacts && pnpm test:integration",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:artifacts": "node --test scripts/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "pnpm generate:artifacts && pnpm generate:db",
    "generate:artifacts": "node scripts/generate-target-artifacts.ts",
    "generate:db": "node scripts/generate-db-types.ts",
    "generate:check": "pnpm generate && git diff --exit-code -- src/generated",
    "check:catalog": "node scripts/check-target-catalog.ts",
    "validate:rpt": "node scripts/validate-rpt-definitions.ts",
    "seed:online-test": "node scripts/seed-online-test-users.ts",
    "sync:catalog": "node scripts/sync-target-catalog.ts",
    "cleanup:legacy-menu": "node scripts/cleanup-legacy-menu.ts",
    "backfill:user-py": "node scripts/backfill-user-pinyin.ts",
    "migrate:aux-people": "node scripts/migrate-aux-people.ts",
    "e2e": "node scripts/run-target-e2e.ts",
    "migrate:aux-assets": "node scripts/migrate-aux-assets.ts",
    "migrate:bob-archives": "node scripts/migrate-bob-archives.ts",
    "migrate:bob-customer": "node scripts/migrate-bob-customer.ts",
    "migrate:bob-product": "node scripts/migrate-bob-product.ts",
    "migrate:wfl": "node scripts/migrate-wfl.ts",
    "migrate:rpt": "node scripts/migrate-rpt.ts",
    "migrate:acc-mapping": "node scripts/migrate-acc-mapping.ts",
    "e2e:vou-catalog": "node scripts/run-vou-catalog-e2e.mjs",
    "migrate:vou-opening": "node scripts/migrate-vou-opening.ts",
    "e2e:vou-opening": "node scripts/run-vou-opening-e2e.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.2",
    "@noble/hashes": "2.4.0",
    "@zerp/model": "workspace:*",
    "@zerp/wfl-starlark": "workspace:*",
    "hono": "4.13.5",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "pinyin-pro": "3.29.3",
    "ulid": "3.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.15.6",
    "kysely-codegen": "0.20.0"
  }
}
