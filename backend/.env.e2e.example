APP_ENV=test
API_PORT=18081
WEB_PORT=15174
POSTGRES_PORT=55435
POSTGRES_DB=zerp_e2e
POSTGRES_USER=zerp_e2e
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgres://zerp_e2e:replace-with-a-random-local-password@127.0.0.1:55435/zerp_e2e?sslmode=disable
CORS_ALLOWED_ORIGINS=http://127.0.0.1:15174
HTTP_READ_TIMEOUT=2m
HTTP_WRITE_TIMEOUT=2m
HTTP_IDLE_TIMEOUT=60s
APP_SESSION_COOKIE_NAME=zerp_e2e_session
APP_SESSION_COOKIE_SECURE=false
APP_SESSION_COOKIE_SAME_SITE=lax
APP_BOOTSTRAP_USERNAME=e2e-admin
APP_BOOTSTRAP_DISPLAY_NAME=E2E-Administrator
APP_BOOTSTRAP_PASSWORD=replace-with-a-random-local-password
TEST_SEED_ADMIN_USERNAME=replace-with-a-test-admin-username
TEST_SEED_ADMIN_DISPLAY_NAME=replace-with-a-test-admin-display-name
TEST_SEED_ADMIN_PASSWORD=replace-with-a-test-admin-password
TEST_SEED_USER_USERNAME=replace-with-a-test-user-username
TEST_SEED_USER_DISPLAY_NAME=replace-with-a-test-user-display-name
TEST_SEED_USER_PASSWORD=replace-with-a-test-user-password
