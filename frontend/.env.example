# 本地开发与容器部署统一使用同源代理。
VITE_API_BASE_URL=/api/

# 以下变量仅供 Playwright 本地/CI 进程读取，不会进入前端构建。
E2E_API_BASE_URL=https://api-test.example.com/
E2E_USERNAME=
E2E_PASSWORD=
E2E_REVIEWER_USERNAME=
E2E_REVIEWER_PASSWORD=
# 可选：仅缺少 procurement-get 的账号，用于验证采购正文后端脱敏。
E2E_WFL_REDACTED_USERNAME=
E2E_WFL_REDACTED_PASSWORD=

# VOU E2E 使用的有效 BOB 基础资料关键字（推荐填写唯一编码）。
# 客户必须配置结算方式；车辆必须属于这里指定的物流平台。
E2E_VOU_CUSTOMER_KEYWORD=
E2E_VOU_SUPPLIER_KEYWORD=
E2E_VOU_EMPLOYEE_KEYWORD=
E2E_VOU_WAREHOUSE_KEYWORD=
E2E_VOU_PRODUCT_KEYWORD=
E2E_VOU_RESIN_PRODUCT_KEYWORD=
E2E_VOU_PLATFORM_KEYWORD=
E2E_VOU_VEHICLE_KEYWORD=
E2E_VOU_FUND_ACCOUNT_KEYWORD=
E2E_VOU_CURRENCY=CNY
# WFL 默认复用上述双账号与 VOU 基础资料；以下开关仅对可按测试运行重置的隔离后端开启。
# 开启后通过真实 APP/BOB API
# 创建临时复核用户、精确权限角色和 WFL 基础资料，临时凭证只写入 test-results。
E2E_WFL_BOOTSTRAP=false
# LED E2E 只允许在已启用的隔离账簿上以只读方式运行。
E2E_LED_READONLY=0
