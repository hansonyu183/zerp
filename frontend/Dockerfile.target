FROM node:26-alpine AS build

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json frontend/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/model/package.json packages/model/package.json
COPY apps/api/package.json apps/api/package.json
RUN npm install --global pnpm@10.34.5 && pnpm install --frozen-lockfile --filter @zerp/frontend...

COPY frontend frontend
COPY packages/api-client packages/api-client
COPY packages/model packages/model
COPY apps/api apps/api

ARG VITE_TARGET_API_BASE_URL
ARG GITHUB_SHA
ENV VITE_TARGET_API_BASE_URL=$VITE_TARGET_API_BASE_URL
ENV GITHUB_SHA=$GITHUB_SHA
RUN pnpm --filter @zerp/frontend build:target

FROM nginx:1.29-alpine

ARG VITE_TARGET_API_BASE_URL
ENV ZERP_API_BROWSER_URL=$VITE_TARGET_API_BASE_URL
COPY --from=build /workspace/frontend/dist-target /usr/share/nginx/html
COPY frontend/nginx.target.conf /etc/nginx/templates/default.conf.template
EXPOSE 80
