{
  "name": "@zerp/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b --force",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "lint": "oxlint --quiet .",
    "format": "prettier --write .oxlintrc.json package.json vite.config.ts vitest.config.ts playwright.config.ts \"scripts/**/*.mjs\" \"README.md\"",
    "format:check": "prettier --check .oxlintrc.json package.json vite.config.ts vitest.config.ts playwright.config.ts \"scripts/**/*.mjs\" \"README.md\"",
    "check:deployment-config": "node scripts/check-deployment-config.mjs",
    "docs:check": "pnpm --dir .. docs:check",
    "check:whitespace": "git diff --check",
    "check": "pnpm check:core && pnpm docs:check && pnpm check:whitespace",
    "check:core": "pnpm lint && pnpm format:check && pnpm check:deployment-config && pnpm test:vue-template-typecheck && pnpm test:coverage && pnpm build",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:vue-template-typecheck": "node --test scripts/vue-template-typecheck.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "openapi-fetch": "^0.15.0",
    "pinia": "^3.0.4",
    "quickjs-emscripten": "^0.32.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.80.0",
    "oxc-parser": "^0.147.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.100.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.15.tsgo.7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.10",
    "vue-tsc": "3.3.11"
  }
}
