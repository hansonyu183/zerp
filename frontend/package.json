{
  "name": "@zerp/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "pnpm dev:target",
    "dev:target": "vite --config vite.target.config.ts",
    "typecheck": "vue-tsc -b --force",
    "build": "pnpm build:target",
    "build:target": "vite build --config vite.target.config.ts",
    "preview": "vite preview --config vite.target.config.ts",
    "lint": "oxlint --quiet src/target tests/unit/target tests/target-e2e",
    "format": "prettier --write .oxlintrc.json package.json vite.target.config.ts playwright.target.config.ts vitest.config.ts \"src/target/**/*.{ts,vue}\" \"tests/{unit/target,target-e2e}/**/*.{ts,vue}\" \"README.md\"",
    "format:check": "prettier --check .oxlintrc.json package.json vite.target.config.ts playwright.target.config.ts vitest.config.ts \"src/target/**/*.{ts,vue}\" \"tests/{unit/target,target-e2e}/**/*.{ts,vue}\" \"README.md\"",
    "check": "pnpm lint && pnpm format:check && pnpm test:unit && pnpm build:target",
    "test": "pnpm test:unit && pnpm test:target",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:target": "playwright test --config playwright.target.config.ts"
  },
  "dependencies": {
    "@zerp/api-client": "workspace:*",
    "@zerp/model": "workspace:*",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.80.0",
    "pg": "8.23.0",
    "prettier": "^3.9.6",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.15.tsgo.7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "3.3.11"
  }
}
