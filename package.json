{
  "name": "zerp",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "make dev",
    "build": "make build",
    "check": "make check",
    "test": "make test",
    "e2e": "make e2e",
    "generate": "make generate",
    "generate:check": "make generate-check",
    "docs:coverage": "node scripts/check-docs.mjs --write-use-case-coverage",
    "docs:adr-index": "node scripts/check-docs.mjs --write-adr-index",
    "docs:check": "node scripts/check-docs.mjs && node --test scripts/check-docs.test.mjs",
    "check:ci-workflow": "node --test scripts/check-ci-workflow.test.mjs",
    "format": "prettier --write \"*.json\" \"*.yaml\" \"*.md\" \".github/workflows/*.yml\" \"docs/**/*.md\" \"frontend/*.md\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"*.json\" \"*.yaml\" \"*.md\" \".github/workflows/*.yml\" \"docs/**/*.md\" \"frontend/*.md\" \"scripts/**/*.mjs\""
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.15.tsgo.7.0.2"
  }
}
